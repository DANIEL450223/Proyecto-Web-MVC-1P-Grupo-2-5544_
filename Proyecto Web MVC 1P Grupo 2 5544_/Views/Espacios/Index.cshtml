@model IEnumerable<Proyecto_Web_MVC_1P_Grupo_2_5544_.Models.Espacios>

@{
    ViewData["Title"] = "Espacios";
}

<h1>Espacios</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.estadoEspacio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vehiculo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.estadoEspacio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Vehiculo.vehiculoId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.espacioId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.espacioId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.espacioId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
