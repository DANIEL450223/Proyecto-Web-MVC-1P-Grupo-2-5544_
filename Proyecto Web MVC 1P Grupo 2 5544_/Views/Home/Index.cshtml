@{
    ViewData["Title"] = "Home Page";
}

<div class="contenedor-principal">
    <header>

    </header>

    <main class="contenido-centro">
        <div class="text-center titulo-principal">
            <h1>Descubre una manera más<br>fácil de conseguir<br>parqueadero</h1>
        </div>
    </main>

    <footer class="footer">
        <p>© 2025 U-PARKING</p>
    </footer>
</div>

<img src="~/images/parking.png" alt="parking" class="img-pantalla-completa" />

<style>

    .img-pantalla-completa {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }


    .contenedor-principal {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

 
    main.contenido-centro {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }


    .titulo-principal h1 {
        color: white;
        font-size: 3rem;
        font-weight: bold;
        text-shadow: 2px 2px 5px rgba(0,0,0,0.7);
        margin: 0;
    }

  
    .footer {
        text-align: center;
        padding: 1rem;
        background: rgba(0, 0, 0, 0.5); 
        color: white;
        font-size: 1rem;
    }
</style>
